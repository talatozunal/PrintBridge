<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>PhonePrint</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>PrintBridge ajanını aynı Wi-Fi ağında bulmak ve yazdırmak için yerel ağ erişimi gerekir.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_printbridge._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>PC ile eşleştirmek için QR kodu okumak amacıyla kamera kullanılır.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Yazdırmak için fotoğraf seçmek amacıyla fotoğraf kitaplığına erişilir.</string>
</dict>
</plist>
